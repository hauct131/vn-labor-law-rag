!data/quality/unified_e5_token_audit/**

# Stable unified-candidate evaluation reports
!data/evaluation/results/
data/evaluation/results/*
!data/evaluation/results/unified_*.json

# Generated graph/runtime data
data/graph/*
!data/graph/.gitkeep

# Large generated review artifacts and OCR derivatives
data/derived/
data/processed/phapdien_chunk_quality_audit/
data/processed/vbpl_chunk_quality_audit/

experiments/*
!experiments/.gitkeep

# Backups and runtime state
.env.bak.*
docker-compose.yml.bak.*
qdrant_storage/
.cache/
*.log
cookies.json
session.json
credentials*.json

# Raw HTTP transport responses may contain transient Set-Cookie headers
data/raw/vbpl/**/portal/api_responses.json
data/raw/vbpl/**/portal/responses/*.response.json

# Snapshot checksum inventories include local-only transport response files
data/raw/vbpl/**/SHA256SUMS.txt

# Regenerable VBPL crawler cache
data/raw/vbpl/_cache/

# Regenerable VBPL crawler cache
data/raw/vbpl/_cache/

# Local secrets and audit artifacts
.env.pre-qdrant-alias-*
.patch_backups/
logs/

# Interrupted local releases
data/releases/.labor-law-*.staging.*/
data/releases/*.failed-*/
data/releases/*.pre-resume-*/
data/releases/*.rollback-*/
