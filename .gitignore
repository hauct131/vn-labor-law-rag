.DS_Store

# Raw reproducible corpora
data/raw/*
!data/raw/.gitkeep
!data/raw/DeMuc_20.2_Lao_Dong.html

# Keep production VBPL snapshots, exclude diagnostics/smoke data
!data/raw/vbpl/
!data/raw/vbpl/**
data/raw/vbpl/_diagnostics/
data/raw/vbpl-smoke/

# Generated canonical corpora: ignore by default
data/processed/*
!data/processed/.gitkeep

# Pháp điển canonical corpus
!data/processed/html_inspection.json
!data/processed/parser_report.json
!data/processed/articles_raw.json
!data/processed/legal_chunks.jsonl
!data/processed/chunking_summary.json

# VBPL canonical corpus
!data/processed/vbpl_articles_raw.json
!data/processed/vbpl_legal_chunks.jsonl
!data/processed/vbpl_chunking_summary.json

# Future unified corpus
!data/processed/unified_legal_articles.json
!data/processed/unified_legal_chunks.jsonl
!data/processed/unified_chunking_summary.json

# Evaluation datasets
data/evaluation/*
!data/evaluation/.gitkeep
!data/evaluation/*.json
!data/evaluation/*.jsonl
!data/evaluation/*.csv
!data/evaluation/*.md

# Reproducibility manifests
data/manifests/*
!data/manifests/.gitkeep
!data/manifests/*.json

# Stable quality reports only
data/quality/*
!data/quality/vbpl_article_build_report.json
!data/quality/vbpl_chunk_quality_report.json
