# Application
APP_NAME="Vietnamese Labor Law RAG"
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Retrieval
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=labor_law_active
QDRANT_EXPECTED_COLLECTION=labor_law_canonical_word_20260804_fdbec539
QDRANT_API_KEY=
QDRANT_READINESS_TIMEOUT_SECONDS=3
RUNTIME_READINESS_TTL_SECONDS=30
RUNTIME_READINESS_FAILURE_TTL_SECONDS=5
RUNTIME_JAVA_TIMEOUT_SECONDS=3
LEGAL_CHUNKS_PATH=data/releases/labor-law-canonical-word-20260804-164432-candidate/canonical_chunks.jsonl
CORPUS_RELEASE_MANIFEST_PATH=data/releases/labor-law-canonical-word-20260804-164432-candidate/manifest.json
E5_AUDIT_SUMMARY_PATH=data/releases/labor-law-canonical-word-20260804-164432-candidate/e5_audit/summary.json
CORPUS_RELEASE_ID=labor-law-canonical-word-20260804-164432-candidate
CORPUS_REQUIRE_AUTHORITY_APPROVAL=true
RETRIEVAL_EXPECTED_CHUNKS=804
RETRIEVAL_CORPUS_SHA256=fdbec539efbfb3f4aa3cb3962046321e3a402150d93516ef4256934972c70307
VNCORENLP_MODEL_DIR=models/vncorenlp
FASTEMBED_CACHE_DIR=
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=30
HYBRID_RRF_K=60
HYBRID_DENSE_WEIGHT=0.9
HYBRID_SPARSE_WEIGHT=0.1


# OpenRouter — never commit the real key.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
# Safety guard: blocks model IDs that are not openrouter/free or :free.
OPENROUTER_REQUIRE_FREE_MODEL=true
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_TOKENS=1200
# Nemotron 3 Ultra enables high reasoning by default. Reserve only a small
# reasoning budget so it cannot consume the whole completion and cut the answer.
# Set to 0 when using a model that does not support reasoning controls.
OPENROUTER_REASONING_MAX_TOKENS=128
OPENROUTER_EXCLUDE_REASONING=true
OPENROUTER_TEMPERATURE=0
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_TITLE="Vietnamese Labor Law RAG"

# Graph stage (not used by sparse/hybrid MVP yet)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# Relational application data (conversation history and bookmarks)
POSTGRES_DB=labor_law_rag
POSTGRES_USER=labor_law
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=sqlite+pysqlite:///./application.db
DATABASE_URL_DOCKER=postgresql+psycopg://labor_law:change_this_local_password@postgres:5432/labor_law_rag
DATABASE_ECHO=false
DATABASE_AUTO_CREATE=true

# Server-side session authentication
SESSION_COOKIE_NAME=legal_rag_session
CSRF_COOKIE_NAME=legal_rag_csrf
# Local HTTP must keep this false. Set true behind HTTPS in production.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=604800
SESSION_TOUCH_INTERVAL_SECONDS=300
PASSWORD_PBKDF2_ITERATIONS=600000
